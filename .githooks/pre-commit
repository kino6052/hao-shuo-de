#!/bin/sh
# What every commit does, in order:
#   1. refreshes the generated parts of the READMEs (scripts/generate-readme.js) and stages them -- never blocks
#   2. checks that src/data/*/index.ts matches the data files (scripts/check-data.js, reading the data bundle) -- about 3.5 s
#   3. runs the quick tests (node scripts/test.js --fast): 730 tests over the fixture language, about 6 s
# Together about 10 s. Everything slower waits: `node scripts/test.js` before a push (the solver and the real
# data), `node scripts/test.js --all` when asked (a copy of the repo, a git ref, the server over stdio), and
# `npm run check` for the 17 book gates.
#
# To commit without 2 and 3: git commit --no-verify
node scripts/generate-readme.js --stage || echo "pre-commit: the README refresh failed (run 'npm run readme' to see why); committing anyway."

if ! node --import ./scripts/fast-data.js scripts/check-data.js; then
  echo ""
  echo "pre-commit: the generated data is out of date -- run 'npm run data' and stage what it writes."
  echo "            to commit anyway: git commit --no-verify"
  exit 1
fi

if ! node scripts/test.js --fast; then
  echo ""
  echo "pre-commit: a quick test fails. Run 'npm test' to see it again."
  echo "            to commit anyway: git commit --no-verify"
  exit 1
fi
exit 0
